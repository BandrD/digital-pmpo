# Скопируйте этот файл в .env и заполните значения.
# .env в git не попадает.

# Токен чат-бота MAX.
# business.max.ru → Чат-боты → бот → Настройки.
MAX_BOT_TOKEN=

# Часовой пояс логов бота. Для команд пояс задаётся в самом боте (МСК или ЕКБ).
TIMEZONE=Asia/Yekaterinburg

# Id пользователей MAX, которым доступны админ-команды (/add_curator, /token_report).
# JSON-массив чисел. Пустой массив — админов нет.
ADMINS_MAX_IDS=[]

# --- Postgres ---
# Бот на вашей машине, база в Docker:
#   PGHOST=127.0.0.1
#   PGPORT=55432          этот порт проброшен на хост (docker-compose: ${PGPORT}:5432)
# Бот тоже в docker compose (сервис bot рядом с db):
#   PGHOST=db
#   PGPORT=5432           внутри сети Postgres слушает 5432, не проброшенный порт
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=dailybot
PGUSER=dailybot
PGPASSWORD=
PGSSLMODE=disable

# Либо одной строкой вместо полей выше. Если DATABASE_URL задан, поля PG* для бота не используются.
# Для контейнера db в compose PGDATABASE, PGUSER, PGPASSWORD и PGPORT всё равно нужны.
# DATABASE_URL=postgresql://dailybot:пароль@127.0.0.1:55432/dailybot?sslmode=disable

# Пул соединений. Можно не менять.
PGPOOL_MIN=1
PGPOOL_MAX=10

# --- Необязательно ---

# Куда слать ошибки бота. Id чата MAX (положительное число), бот должен быть в этом чате.
# Пусто — ошибки только в консоль.
ERROR_LOG_CHAT_ID=

# Куда слать недельный отчёт по токенам LLM.
WEEKLY_TOKEN_REPORT_CHAT_ID=

# Ключи OpenRouter для отчёта по статусу и уточняющего вопроса.
# Без них дейли собирается, сводка от модели не строится.
# Несколько бесплатных ключей — через запятую.
OPENROUTER_FREE_KEY=
OPENROUTER_PAID_KEY=

# Сертификат Минцифры уже лежит в bot/certs/. Заполняйте только если файл в другом месте.
# MAX_ROOT_CA_PATH=
